# ═══════════════════════════════════════════════
# MIRAGE MARKET — Environment Variables
# Copy to .env.local and fill in values
# ═══════════════════════════════════════════════

# World ID
NEXT_PUBLIC_WORLD_APP_ID=app_xxx
NEXT_PUBLIC_WORLD_RP_ID=rp_xxx
RP_SIGNING_KEY=your_signing_key_here       # NEVER commit actual value

# Blockchain — Tenderly Virtual TestNet
NEXT_PUBLIC_TENDERLY_RPC_URL=https://virtual.sepolia.rpc.tenderly.co/xxx
TENDERLY_RPC_URL=https://virtual.sepolia.rpc.tenderly.co/xxx   # Server-side (admin RPC)
DEPLOYER_PRIVATE_KEY=0x...                 # NEVER commit

# CRE (reference — set via `cre secrets set`)
# DATA_API_KEY=your_coingecko_key
# These are NOT in .env — use: cre secrets set DATA_API_KEY

# WalletConnect
NEXT_PUBLIC_WALLETCONNECT_ID=xxx
