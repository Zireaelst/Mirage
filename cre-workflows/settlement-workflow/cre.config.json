{
    "name": "mirage-settlement-workflow",
    "version": "0.1.0",
    "description": "CRE workflow: MarketClosed EVM log → Confidential HTTP data fetch → AI settlement → onchain write",
    "trigger": {
        "type": "evm-log",
        "config": {
            "chainName": "ethereum-sepolia",
            "contractAddress": "0x54576aC5a0cF7566287d7fcb410c8f523357889d",
            "eventSignature": "MarketClosed(bytes32)",
            "eventName": "MarketClosed"
        }
    },
    "consensus": {
        "type": "identical",
        "aggregation": "consensusIdenticalAggregation"
    },
    "target": {
        "type": "evm-write",
        "config": {
            "chainName": "ethereum-sepolia",
            "contractAddress": "0x25Fb1b433Db1dFAfF1C73Dd189E7183d8fDe0FC4"
        }
    },
    "config": {
        "shadowMarketAddress": "0x54576aC5a0cF7566287d7fcb410c8f523357889d",
        "settlementReceiverAddress": "0x25Fb1b433Db1dFAfF1C73Dd189E7183d8fDe0FC4",
        "chainName": "ethereum-sepolia",
        "dataApiUrl": "https://api.coingecko.com"
    },
    "secrets": [
        "DATA_API_KEY"
    ]
}